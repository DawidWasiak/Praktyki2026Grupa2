<!DOCTYPE html>
<html lang="pl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Interfejs</title>
<link rel="stylesheet" href="style.css">
<script type="module" src="./main.js"></script>
</head>
<body>

<div class="container">
  <div class="importRow">
    <div id="dropZone">
      DROP
      <small>Перетягни сюди файл .txt</small>
    </div>
    <button id="browseButton" type="button">BROWSE</button>
    <input type="file" id="fileInput" accept=".txt,text/plain">
  </div>

  <div id="status"></div>

  <textarea id="textWindow" readonly placeholder="Тут з'явиться текст з файлу..."></textarea>
</div>

<!-- main.js використовує import, тому працює тільки через сервер (Live Server), а не з file:// -->
<script type="module" src="main.js"></script>

<script>

  if (location.protocol === "file:") {
    const statusEl = document.getElementById("status");
    statusEl.textContent = "Сторінку відкрито як файл (file://), тому браузер блокує main.js. Відкрий її через Live Server.";
    statusEl.classList.add("error");
  }
</script>

</body>
</html>

* {
    box-sizing: border-box;
}

body {
    margin: 0;
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 16px;
    font-family: system-ui, Arial, sans-serif;
    background: #f2f4f7;
    color: #222;
}

.container {
    width: 100%;
    max-width: 720px;
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 24px;
    background: #fff;
    border: 2px solid #333;
    border-radius: 12px;
}


.importRow {
    display: flex;
    gap: 16px;
    align-items: stretch;
}

#dropZone {
    flex: 1;
    padding: 28px 12px;
    text-align: center;
    font-size: 22px;
    font-weight: bold;
    letter-spacing: 3px;
    color: #555;
    border: 2px dashed #555;
    border-radius: 10px;
    transition: background .2s, border-color .2s;
}

#dropZone small {
    display: block;
    margin-top: 6px;
    font-size: 13px;
    font-weight: normal;
    letter-spacing: 0;
    pointer-events: none; 
}


#dropZone.dragover {
    background: #e6f0ff;
    border-color: #2a6df4;
    color: #2a6df4;
}

#browseButton {
    padding: 0 24px;
    font-size: 18px;
    font-weight: bold;
    letter-spacing: 2px;
    background: #fff;
    border: 2px solid #333;
    border-radius: 10px;
    cursor: pointer;
}

#browseButton:hover {
    background: #333;
    color: #fff;
}

#fileInput {
    display: none;
}

#status {
    min-height: 18px;
    font-size: 14px;
    color: #666;
}

#status.error {
    color: #c62828;
}


#textWindow {
    width: 100%;
    min-height: 280px;
    padding: 12px;
    font-family: inherit;
    font-size: 15px;
    background: #fafafa;
    border: 2px solid #333;
    border-radius: 10px;
    resize: vertical;
    cursor: default;
}

#textWindow:focus {
    outline: none;
}

@media (max-width: 500px) {
    .importRow {
        flex-direction: column;
    }

    #browseButton {
        padding: 14px;
    }
}

